---
// Homepage (2026-10 refresh). Six movements: hero, problem transition, Workstation reveal, capability map,
// two application lenses, close (the contact surface). Single-page release: no links to deeper pages until they exist.
import SiteLayout from "../layouts/SiteLayout.astro";

const principle = ["What happened.", "In what order.", "Against what state.", "With what evidence."];

const callouts = [
  { title: "Last known good → failure state", body: "An explicit reconstruction boundary." },
  { title: "First divergence and propagation leads", body: "Where observed change began and how it spread." },
  { title: "State and mutation evidence", body: "What changed, per entity, field by field." },
];

const jobs = [
  { verb: "Reconstruct", gist: "Recover coherent state from fragmented evidence." },
  { verb: "Control", gist: "Keep consequential actions bounded to explicit state." },
  { verb: "Verify", gist: "Recheck what occurred against retained evidence." },
  { verb: "Translate", gist: "Give each role its own view of the same record." },
  { verb: "Execute", gist: "Coordinate people, software and AI around controlled state." },
];

const lenses = [
  { name: "Physical operations", items: ["Delivery & commissioning", "Migrations & cutovers", "Investigations & reconstruction"] },
  { name: "AI-native operations", items: ["Multi-model workflows", "Changing business context", "Tool actions & human escalation"] },
];
---

<SiteLayout title="Prima Veritas · Operational truth for complex systems">
  <main>
    <!-- 1. Hero -->
    <section class="hero wrap" aria-labelledby="hero-title">
      <h1 id="hero-title">Operational truth for complex systems</h1>
      <div class="below">
        <p class="lede">Prima Veritas is an execution and assurance platform for complex work involving people, software systems and AI.</p>
        <ul class="principle" aria-label="The record Prima Veritas keeps">
          {principle.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>

    <!-- 2. Problem transition -->
    <section class="transition wrap" aria-label="The problem">
      <div class="grid">
        <p class="statement">The real state of complex work rarely lives in one place.</p>
        <p class="follow">Systems, teams and AI each hold pieces of it. Prima Veritas sits across that environment without replacing the systems already doing the work.</p>
      </div>
    </section>

    <!-- 3. Workstation reveal -->
    <section class="reveal wrap" id="workstation" aria-labelledby="ws-title">
      <div class="head">
        <p class="kicker">The Workstation</p>
        <h2 id="ws-title">See what changed, what changed first, and what followed.</h2>
        <p class="intro">One working surface for reconstructing operational state, following consequential changes and inspecting the evidence behind them.</p>
      </div>
      <figure class="shot">
        <div class="frame">
          <img src="/images/workstation-flagship-2x.png" width="2560" height="1440" loading="lazy" decoding="async"
            alt="The Prima Veritas Workstation: an operational timeline with the boundary between last known good state and failure state marked, a propagation chain across entities, and a reconstruction board listing state and mutation evidence." />
        </div>
        <ul class="callouts">
          {callouts.map((c) => <li><strong>{c.title}</strong><span>{c.body}</span></li>)}
        </ul>
        <figcaption class="honesty">Running today with a synthetic flagship scenario.</figcaption>
      </figure>
    </section>

    <!-- Thesis transition: execution → investigation → assurance -->
    <section class="thesis wrap" aria-label="Why the record matters">
      <p>The result isn’t just another account of what happened. It’s an operational record that can be acted on, investigated and independently rechecked.</p>
    </section>

    <!-- 4. Capability map -->
    <section class="map wrap" aria-labelledby="map-title">
      <div class="top">
        <h2 id="map-title">One operational foundation. Different jobs.</h2>
        <p class="status">PV is being built around five connected capabilities.</p>
      </div>
      <ol>
        {jobs.map((j) => (
          <li>
            <span class="verb">{j.verb}</span>
            <span class="gist">{j.gist}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 5. Two lenses, one architecture -->
    <section class="lenses wrap" aria-labelledby="apps-title">
      <div class="grid">
        <div>
          <h2 id="apps-title">Where work crosses boundaries.</h2>
          <p class="bridge">Different environments. The same underlying problem: consequential work distributed across participants and systems.</p>
        </div>
        <div class="pair">
          {lenses.map((l) => (
            <div>
              <h3>{l.name}</h3>
              <ul>{l.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Close -->
    <section class="close wrap" id="contact" aria-labelledby="close-title">
      <div class="accent"></div>
      <h2 id="close-title"><span>Find one consequential workflow.</span> <span>Bound it tightly.</span> <span>Prove it against the real operation.</span></h2>
      <div class="act">
        <a class="btn solid" href="mailto:contact@primaveritas.io">Talk to us</a>
        <span class="email">contact@primaveritas.io</span>
      </div>
      <div class="deploy">
        <p class="lead">Designed to run where the operation requires.</p>
        <p class="modes">Cloud-connected<span class="sep"> · </span>private<span class="sep"> · </span>on-premises<span class="sep"> · </span>air-gapped</p>
      </div>
    </section>
  </main>
</SiteLayout>
