---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
---

<Layout title="Prima Veritas">

<main class="flex-1">

  <!-- HERO -->
  <PageHero
    title="Reconstruct Operational History Across Systems"
    subtitle="Prima Veritas converts fragmented operational logs into a single, hash-chained history of events."
  />

  <!-- WHY IT MATTERS -->
  <Section title="Why it matters">
    <p>
      When operational history is unclear, teams waste time reconstructing events,
      resolving conflicting records, and defending decisions across systems.
    </p>
    <p>
      Prima Veritas is designed to produce a single, hash-chained record of what the source
      data says happened, so teams work from one account instead of several.
    </p>
  </Section>

  <!-- DIAGRAM -->
  <Section title="From scattered logs to a hash-chained history" bare>
    <p class="mt-4 text-sm text-off-white/80">
      This is how fragmented records become a single, ordered history.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-between text-sm text-off-white/80">

      <div class="text-center">
        <div class="text-off-white opacity-90">Operational Logs</div>
        <div class="text-off-white opacity-75">CSV / system events</div>
      </div>

      <div class="text-off-white/40">→</div>

      <div class="text-center">
        <div class="text-off-white opacity-90">Structured Event History</div>
        <div class="text-off-white opacity-75">events.jsonl</div>
      </div>

      <div class="text-off-white/40">→</div>

      <div class="text-center">
        <div class="text-off-white opacity-90">Sealed Bundle</div>
        <div class="text-off-white opacity-75">bundle.zip</div>
      </div>

      <div class="text-off-white/40">→</div>

      <div class="text-center">
        <div class="text-off-white opacity-90">Integrity Hash</div>
        <div class="text-off-white opacity-75">SHA-256</div>
      </div>

    </div>

    <p class="mt-10 text-sm text-off-white/75 text-center max-w-3xl mx-auto">
      Prima Veritas converts fragmented operational logs into a structured, hash-chained history
      and a portable bundle identified by its SHA-256 hash.
    </p>
  </Section>

<!-- SEE A RECONSTRUCTION: removed 2026-09-30 (PV-EVH-001 Phase 0). The displayed sample hashes did not match the sample bundles' contents. -->

  <!-- WHAT THE SYSTEM GUARANTEES -->
  <Section title="What the system does" bare>
    <div class="mt-6 grid md:grid-cols-2 max-w-4xl gap-10 text-sm text-off-white/80">
      <div>
        <strong class="text-off-white">Consistent event history</strong><br/>
        Events are normalized into a single, ordered record across systems.
      </div>
      <div>
        <strong class="text-off-white">Hash-chained sequence</strong><br/>
        Changes inside a sealed record are detectable. Replacing the whole record is detectable
        only against a receipt kept separately.
      </div>
      <div>
        <strong class="text-off-white">Reproducible output</strong><br/>
        The same input produces the same output (shown on one machine; cross-machine testing pending).
      </div>
      <div>
        <strong class="text-off-white">Recheckable outside your systems</strong><br/>
        A record can be rechecked without access to the systems that produced it. The check
        states what it trusts.
      </div>
    </div>
  </Section>

  <!-- PRODUCTION CAPABILITIES -->
  <Section title="Roadmap (in development, not yet available)" bare>
    <div class="mt-6 grid md:grid-cols-2 max-w-4xl gap-10 text-sm text-off-white/80">
      <div>
        <strong class="text-off-white">Replayable timeline visualization</strong><br/>
        Interactively reconstruct operational events with filtering, zoom, and cross-system traceability.
      </div>
      <div>
        <strong class="text-off-white">Continuous verification</strong><br/>
        Automatically generate and validate verification bundles from recurring operational data.
      </div>
      <div>
        <strong class="text-off-white">Audit-ready exports</strong><br/>
        Produce structured reports for internal review.
      </div>
      <div>
        <strong class="text-off-white">Cross-system lineage</strong><br/>
        Trace relationships between systems, teams, and events across time.
      </div>
    </div>
  </Section>

  <!-- REAL WORLD APPLICATIONS -->
  <Section title="Designed for" bare>
    <p class="mt-4 text-sm text-off-white/60">
      Target settings. Work to date uses synthetic data only; there are no production deployments.
    </p>
    <div class="mt-6 grid md:grid-cols-3 gap-8 text-sm text-off-white/80">
      <div>
        <strong class="text-off-white">Logistics & Shipyards</strong><br/>
        Records of what happened, when, and who did what across builds and handoffs.
      </div>
      <div>
        <strong class="text-off-white">Robotics & Industrial Systems</strong><br/>
        Records of how systems behaved over time.
      </div>
      <div>
        <strong class="text-off-white">Energy & Infrastructure</strong><br/>
        One ordered history across systems and vendors.
      </div>
    </div>
  </Section>

  <!-- CONTACT -->
  <Section title="Technical Review" last={true}>
    <p>
      We start with a small, well-defined dataset and produce an ordered, hash-chained record of
      what the source data says happened.
    </p>
    <a href="/contact"
      class="nav-link text-sm hover:text-[var(--accent)] transition-colors">
      → Schedule a Technical Review
    </a>
  </Section>

</main>

</Layout>