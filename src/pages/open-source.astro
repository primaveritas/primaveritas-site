---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Open Source | Prima Veritas">

<main class="flex-1">

  <!-- HERO -->
  <section class="border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <h1 class="font-sans text-4xl md:text-5xl tracking-tight text-off-white leading-tight">
        Open Source & Reproducibility
      </h1>

      <p class="mt-6 max-w-4xl text-xl text-off-white/80">
        The Prima Veritas kernel and build pipeline are not currently published.
        This page will link to source if and when it is released.
      </p>
    </div>
  </section>


  <!-- REPRODUCIBILITY MODEL -->
  <section class="border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <h2 class="text-lg font-sans tracking-tight text-off-white">
        Reproducibility model
      </h2>

      <div class="mt-6 max-w-4xl text-sm text-off-white/80 space-y-6">

        <div>
          <strong>Canonical event envelope</strong>
          <p class="mt-2">
            Events normalize to a stable structure prior to hashing.
            Field order and encoding are deterministic.
          </p>
        </div>

        <div>
          <strong>Append-only hash chain</strong>
          <p class="mt-2">
            Each event embeds the prior event hash. Changing or reordering an event breaks
            the link to every later event. Removing events from the end is detectable only
            against a receipt kept separately.
          </p>
        </div>

        <div>
          <strong>Deterministic bundle export</strong>
          <p class="mt-2">
            Bundles serialize using fixed ordering rules. Identical output from identical
            input has been shown on one machine; cross-machine testing is pending.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- FINAL CTA -->
  <section>
    <div class="max-w-6xl mx-auto px-6 py-10">

      <h2 class="text-lg font-sans tracking-tight text-off-white">
        Technical review
      </h2>

      <div class="mt-10 text-xl">
        <a href="/contact"
           class="inline-block text-off-white hover:text-[var(--accent)] transition-colors">
          Schedule Technical Review →
        </a>
      </div>

    </div>
  </section>

</main>

</Layout>